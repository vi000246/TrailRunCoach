# TrailRunCoach environment variables. Copy to .env (git-ignored) or export them.
# Every variable is optional; the app runs with none of them set.
# Before SP-498 they were called WKO5COACH_* (and WKO5_ATHLETE_DIR / WKO5_VIEWS_DIR): the old
# names still work; when both are set the TRC_* one wins.

# --- Secrets -----------------------------------------------------------------
# Fernet key that encrypts tokens / remembered passwords at rest.
# Unset: ~/.trailruncoach/secret.key is used (generated on first run).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRC_SECRET_KEY=

# TrainingPeaks OAuth client (your own registered client). Unset: website login.
# Alternative: ~/.trailruncoach/tp_client.json  {"client_id": "...", "client_secret": "..."}
TP_CLIENT_ID=
TP_CLIENT_SECRET=

# Debug API for AI agents (docs/debug-api.md, SP-371): personal tokens are made by the owner on
# 設定 › 進階 › Debug API (SP-373: no PIN any more; TRC_DEBUG_PIN is ignored).
# A LOCAL copy that pulls its settings and 課表 from production (SP-373, 設定 › 進階 › 從正式站同步):
# production's address, a token made there with export:config + export:plan (or TRC_UPSTREAM_TOKEN_FILE),
# and the password proxy's account when production sits behind it. Only on your own computer; never
# commit a value, never set these on production itself.
TRC_UPSTREAM_URL=
TRC_UPSTREAM_TOKEN=
TRC_PROXY_USER=
TRC_PROXY_PASSWORD=
# The image's git commit, shown in every debug answer's meta (docker build --build-arg GIT_SHA=...)
TRC_GIT_SHA=

# The race calculator's 土徑比 (SP-543) and the surface in its segment split (SP-727): where the trail
# dictionary (SP-709, tools/trail-dict/) is published, e.g. https://trail-dict.example/ (latest.json at
# its root). The server downloads the bundle (~28 MB) once per version and indexes it locally
# (<server root>/trail-dict/), then looks for a new version once a day. Unset = no lookup (the
# calculator shows 路面未知). No key: the dictionary is public OSM data (ODbL).
TRC_TRAIL_DICT_URL=
# SP-544: the trail technicality only on the dirt share of a GPX course (needs the surface above).
# Off by default: the 2026-10-14 back-test on the owner's trail runs was worse with it (9.4 % -> 9.8 %).
TRC_TECH_DIRT_ONLY=

# Taiwan Central Weather Administration open-data key (race-day weather).
# Alternative: ~/.trailruncoach/weather.json
CWA_API_KEY=

# --- Multi-user mode (SP-384, docs/deploy/accounts.md) ------------------------
# 1 = accounts.db and one tenant folder per signed-in user. Needs TRC_SECRET_KEY (the one
# server key: no key file inside a tenant folder). Sign-in mode = 1 plus the whole sign-in set below;
# none of them = every request is the owner, as before; part of them = the app refuses to start
# (docs/deploy/accounts.md §5).
TRC_ACCOUNTS=
# Where accounts.db and users/<id>/ live. Default: TRC_HOME (~/.trailruncoach)
TRC_SERVER_ROOT=
# Google sign-in (SP-58). Both (or *_FILE, a Docker secret).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required with sign-in: the public origin, https (http only for localhost); the OAuth redirect is
# <it>/oauth/google/callback.
TRC_PUBLIC_URL=
# Which Google account is the owner's (user 1, the existing data). One of them is required with sign-in
# on until the owner has signed in once; prefer the sub (Google's account id) over the e-mail.
TRC_OWNER_GOOGLE_SUB=
TRC_OWNER_EMAIL=
# Sign-up cap: past it new Google accounts only join the waitlist. Default 100 (the owner counts)
TRC_MAX_USERS=
# The proxy in front of the app whose CF-Connecting-IP is trusted (required with an https
# TRC_PUBLIC_URL): only the cloudflared container's address, /32. Default 127.0.0.1/32,::1/128
TRC_TRUSTED_PROXIES=
# Multi-user mode: the whole server's daily backup (accounts.db + every user's tenant), a folder OUTSIDE
# the server root (SP-387); unset = no server backup. _FIT=1 adds the FIT originals.
TRC_SERVER_BACKUP_DIR=
TRC_SERVER_BACKUP_FIT=
# The Dataset cache's memory budget in MB (SP-338). Default 1200
TRC_DATASET_MEM_MB=
# In-memory cache room: how many tenants keep their 課表 / calculator results (SP-374). Default 32
TRC_CACHE_TENANTS=

# --- Data locations ----------------------------------------------------------
# The data folder. Default: ~/.trailruncoach, or ~/.wko5coach when only that one exists (an
# install from before SP-498: used where it is, never moved).
TRC_HOME=
# docker-compose.yml only: the data folder's name under your home (default .trailruncoach;
# .wko5coach for an install from before SP-498 — deploy.sh sets it by itself).
TRC_DATA_FOLDER=
# Comparison folder (owner only: cross-checking the numbers). Default: first match under ~/WKO5.
TRC_ATHLETE_DIR=
# Folder with the comparison folder's exported views (owner only). Unset: no imported
# views (the bundled views still work). Also settable in the app (charts.wko5_views_dir).
TRC_VIEWS_DIR=
# Parsed-FIT cache root. Default: ~/.trailruncoach/cache/fit
TRC_FIT_CACHE=
# Saved race routes (GPX). Default: ~/.trailruncoach/routes
TRC_ROUTES_DIR=
# Read activity tags from another DB (back-test what-ifs).
TRC_TAGS_DB=

# --- Runtime -----------------------------------------------------------------
# Comma-separated CORS origins. Default: http://localhost:8000
CORS_ORIGINS=
# Fallback IANA time zone when the setting is empty, e.g. Asia/Taipei
TRC_TZ=
# UI default locale: zh-TW | en
TRC_DEFAULT_LOCALE=
# "demo" = demo mode
TRC_MODE=
# Set to any value to disable: background sync scheduler / automatic DB backup / cache warm-up
TRC_NO_SCHEDULER=
TRC_NO_AUTO_BACKUP=
TRC_NO_WARMUP=
# Set to 0 to skip weather lookups on the routes page
TRC_ROUTES_WEATHER=
# App log (slow requests / sync steps, exceptions): stderr + ~/.trailruncoach/logs/app.log.
# Level DEBUG | INFO (default) | WARNING; set TRC_LOG_FILE=0 for stderr only
TRC_LOG_LEVEL=
TRC_LOG_FILE=
# Tuning
TRC_THREADS=200
TRC_FIT_WORKERS=
TRC_FIT_OPEN=256

# --- Tests -------------------------------------------------------------------
# Opt in to backend/tests/realdata (reads your real data folders; see its README)
TRC_REALDATA=
