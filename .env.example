# TrailRunCoach environment variables. Copy to .env (git-ignored) or export them.
# Every variable is optional; the app runs with none of them set.

# --- Secrets -----------------------------------------------------------------
# Fernet key that encrypts tokens / remembered passwords at rest.
# Unset: ~/.wko5coach/secret.key is used (generated on first run).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WKO5COACH_SECRET_KEY=

# TrainingPeaks OAuth client (your own registered client). Unset: website login.
# Alternative: ~/.wko5coach/tp_client.json  {"client_id": "...", "client_secret": "..."}
TP_CLIENT_ID=
TP_CLIENT_SECRET=

# Debug API for AI agents (docs/debug-api.md, SP-371): the PIN asked before a debug token is
# made on 設定 › 進階 › Debug API. At least 6 characters. Unset: the debug API cannot be turned on.
# Set it only on the server (the NAS's .env); never commit a value.
TRC_DEBUG_PIN=
# The image's git commit, shown in every debug answer's meta (docker build --build-arg GIT_SHA=...)
TRC_GIT_SHA=

# Taiwan Central Weather Administration open-data key (race-day weather).
# Alternative: ~/.wko5coach/weather.json
CWA_API_KEY=

# --- Data locations ----------------------------------------------------------
# WKO5 athlete folder (<Name>.wko5athlete + year/*.wko4). Default: first match under ~/WKO5.
WKO5_ATHLETE_DIR=
# Folder with your own exported WKO5 views (*.wko5chart). Unset: no imported WKO5
# views (the bundled views still work). Also settable in the app (charts.wko5_views_dir).
WKO5_VIEWS_DIR=
# Parsed-FIT cache root. Default: ~/.wko5coach/cache/fit
WKO5COACH_FIT_CACHE=
# Saved race routes (GPX). Default: ~/.wko5coach/routes
WKO5COACH_ROUTES_DIR=
# Read activity tags from another DB (back-test what-ifs).
WKO5COACH_TAGS_DB=

# --- Runtime -----------------------------------------------------------------
# Comma-separated CORS origins. Default: http://localhost:8000
CORS_ORIGINS=
# Fallback IANA time zone when the setting is empty, e.g. Asia/Taipei
WKO5COACH_TZ=
# UI default locale: zh-TW | en
TRC_DEFAULT_LOCALE=
# "demo" = demo mode
WKO5COACH_MODE=
# Set to any value to disable: background sync scheduler / automatic DB backup / cache warm-up
WKO5COACH_NO_SCHEDULER=
WKO5COACH_NO_AUTO_BACKUP=
WKO5COACH_NO_WARMUP=
# Set to 0 to skip weather lookups on the routes page
WKO5COACH_ROUTES_WEATHER=
# App log (slow requests / sync steps, exceptions): stderr + ~/.wko5coach/logs/app.log.
# Level DEBUG | INFO (default) | WARNING; set WKO5COACH_LOG_FILE=0 for stderr only
WKO5COACH_LOG_LEVEL=
WKO5COACH_LOG_FILE=
# Tuning
WKO5COACH_THREADS=200
WKO5COACH_FIT_WORKERS=
WKO5COACH_FIT_OPEN=256

# --- Tests -------------------------------------------------------------------
# Opt in to backend/tests/realdata (reads your real data folders; see its README)
WKO5COACH_REALDATA=
