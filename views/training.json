{
  "name": "我的訓練",
  "dashboards": [
    {
      "title": "負荷 PMC",
      "description": "所有運動合在一起的訓練負荷：體能 CTL、疲勞 ATL、狀況 TSB，以及每天的 TSS。",
      "charts": [
        {
          "title": "PMC：體能 CTL・疲勞 ATL・狀況 TSB（全部運動）",
          "description": "CTL = 42 天平均負荷，ATL = 7 天，TSB = 昨天的 CTL − ATL。−30～−10 是有效訓練區，賽前 A 賽 +10～+20（Friel / Palladino）。沒有任何登山越野賽公開過經驗證的最佳 TSB，只當方向參考。",
          "axes": [{"id": "TSSPERDAY"}],
          "series": [
            {"name": "CTL 體能", "type": "line", "y_axis": "TSSPERDAY", "color": "#2a78d6", "line_width": "thick", "expression": "ctl"},
            {"name": "ATL 疲勞", "type": "line", "y_axis": "TSSPERDAY", "color": "#eb6834", "expression": "atl"},
            {"name": "TSB 狀況", "type": "line", "y_axis": "TSSPERDAY", "color": "#1baf7a", "expression": "tsb"},
            {"name": "0", "type": "line", "y_axis": "TSSPERDAY", "color": "#8a8984", "line_style": "dash", "expression": "(,0)"},
            {"name": "TSB −30 過度訓練", "type": "line", "y_axis": "TSSPERDAY", "color": "#e34948", "line_style": "dash", "expression": "(,-30)"},
            {"name": "TSB −10 有效訓練上緣", "type": "line", "y_axis": "TSSPERDAY", "color": "#8a8984", "line_style": "dash", "expression": "(,-10)"},
            {"name": "TSB +10 A 賽", "type": "line", "y_axis": "TSSPERDAY", "color": "#1baf7a", "line_style": "dash", "expression": "(,10)"},
            {"name": "TSB +20 A 賽", "type": "line", "y_axis": "TSSPERDAY", "color": "#1baf7a", "line_style": "dash", "expression": "(,20)"}
          ]
        },
        {
          "title": "每日 TSS",
          "axes": [{"id": "TSS", "min": 0}],
          "period": "day",
          "series": [
            {"name": "TSS", "type": "bar", "y_axis": "TSS", "color": "#8a8984", "expression": "sum(tss, trunc(date))"}
          ]
        },
        {
          "title": "體能成長速度（CTL 每週增加）",
          "description": "每週 CTL 增加多少。專項期可以比基礎期快，但太快代表負荷堆太急。",
          "axes": [{"id": "TSSPERDAYPERWEEK"}],
          "series": [
            {"name": "CTL 週變化", "type": "bar", "y_axis": "TSSPERDAYPERWEEK", "color": "#2a78d6", "expression": "tl(tss, ctlconstant) - shift(tl(tss, ctlconstant), 7)"},
            {"name": "0", "type": "line", "y_axis": "TSSPERDAYPERWEEK", "color": "#8a8984", "line_style": "dash", "expression": "(,0)"},
            {"name": "+3 可長期", "type": "line", "y_axis": "TSSPERDAYPERWEEK", "color": "#1baf7a", "line_style": "dash", "expression": "(,3)"},
            {"name": "+5 只撐一兩週", "type": "line", "y_axis": "TSSPERDAYPERWEEK", "color": "#eda100", "line_style": "dash", "expression": "(,5)"},
            {"name": "+7 受傷風險", "type": "line", "y_axis": "TSSPERDAYPERWEEK", "color": "#e34948", "line_style": "dash", "expression": "(,7)"}
          ]
        }
      ]
    },
    {
      "title": "訓練量",
      "description": "每週做了多少：移動時間（依類別）、增幅、爬升、下降、肌力。越野、百岳、騎車的筆數太少，合在一起看。",
      "charts": [
        {
          "title": "每週移動時間（依類別堆疊）",
          "description": "Koop、Jornet、Uphill Athlete 都用時數當主要訓練量。顏色只是看每週重心放在哪裡，高度是全部加總。",
          "axes": [{"id": "HHMMSS", "min": 0}],
          "period": "week",
          "series": [
            {"name": "路跑", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#2a78d6", "expression": "sum(if(sport=\"run\" and !hastag(\"runningtrail\"), movingduration), startofweek(date))"},
            {"name": "越野跑", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#eb6834", "expression": "sum(if(hastag(\"runningtrail\"), movingduration), startofweek(date))"},
            {"name": "登山健行", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#1baf7a", "expression": "sum(if(hastag(\"hiking\") or hastag(\"mountaineering\"), movingduration), startofweek(date))"},
            {"name": "騎車", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#eda100", "expression": "sum(if(sport=\"road bike\" or sport=\"bike\", movingduration), startofweek(date))"},
            {"name": "肌力", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#e87ba4", "expression": "sum(if(sport=\"strength\", movingduration), startofweek(date))"}
          ]
        },
        {
          "title": "每週時數變化（本週 − 上週）",
          "description": "訓練量成長的速度；Uphill Athlete 建議每週 ≤ +10%。只看趨勢——ACWR 類指標預測受傷的說法已被推翻（Impellizzeri 2020）。",
          "axes": [{"id": "HHMMSS"}],
          "period": "week",
          "series": [
            {"name": "本週 − 上週", "type": "bar", "y_axis": "HHMMSS", "color": "#2a78d6", "expression": "sum(movingduration, startofweek(date)) - shift(sum(movingduration, startofweek(date)), 7)"},
            {"name": "0", "type": "line", "y_axis": "HHMMSS", "color": "#8a8984", "line_style": "dash", "expression": "(,0)"}
          ]
        },
        {
          "title": "每週跑量",
          "description": "距離（km），依類別堆疊。點圖例可以只看某一類（例如拿掉登山只看跑步）。",
          "axes": [{"id": "KM", "min": 0}],
          "period": "week",
          "series": [
            {"name": "路跑", "type": "stackedbar", "y_axis": "KM", "color": "#2a78d6", "expression": "sum(if(sport=\"run\" and !hastag(\"runningtrail\"), distance), startofweek(date))"},
            {"name": "越野跑", "type": "stackedbar", "y_axis": "KM", "color": "#eb6834", "expression": "sum(if(hastag(\"runningtrail\"), distance), startofweek(date))"},
            {"name": "登山健行", "type": "stackedbar", "y_axis": "KM", "color": "#1baf7a", "expression": "sum(if(hastag(\"hiking\") or hastag(\"mountaineering\"), distance), startofweek(date))"}
          ]
        },
        {
          "title": "每週努力距離 EP",
          "description": "EP = 距離 km + 爬升 m ÷ 100（健行筆記／ITRA 的算法），把爬升換算成等值的平路距離，路跑、越野、登山可以放在一起比。點圖例可以只看某一類。",
          "axes": [{"id": "KM", "min": 0}],
          "period": "week",
          "series": [
            {"name": "路跑", "type": "stackedbar", "y_axis": "KM", "color": "#2a78d6", "expression": "sum(if(sport=\"run\" and !hastag(\"runningtrail\"), distance + climbing/100), startofweek(date))"},
            {"name": "越野跑", "type": "stackedbar", "y_axis": "KM", "color": "#eb6834", "expression": "sum(if(hastag(\"runningtrail\"), distance + climbing/100), startofweek(date))"},
            {"name": "登山健行", "type": "stackedbar", "y_axis": "KM", "color": "#1baf7a", "expression": "sum(if(hastag(\"hiking\") or hastag(\"mountaineering\"), distance + climbing/100), startofweek(date))"}
          ]
        },
        {
          "title": "每週爬升／下降",
          "description": "兩個長條並排：爬升是垂直訓練量，下降是離心負荷（越野跑肌肉損傷的主因，心率看不出來）。點圖例可以只看爬升或只看下降。總量本身沒有劑量反應，要對照比賽看「每公里爬升」。",
          "axes": [{"id": "METERS", "min": 0}],
          "period": "week",
          "series": [
            {"name": "爬升", "type": "bar", "y_axis": "METERS", "color": "#1baf7a", "expression": "sum(climbing, startofweek(date))"},
            {"name": "下降", "type": "bar", "y_axis": "METERS", "color": "#eb6834", "expression": "sum(descending, startofweek(date))"}
          ]
        },
        {
          "title": "肌力訓練日曆",
          "description": "有練肌力的日子會上色。基礎期目標每週 2 次。",
          "axes": [{"id": "CUSTOM次", "min": 0}],
          "series": [
            {"name": "肌力", "type": "calendar", "y_axis": "CUSTOM次", "color": "#e87ba4", "expression": "count(if(sport=\"strength\", duration), trunc(date))"}
          ]
        }
      ]
    },
    {
      "title": "強度",
      "description": "輕鬆日有沒有真的輕鬆：心率區間、低強度佔比、跑步功率區間。只算移動中的時間。",
      "charts": [
        {
          "title": "每週強度分布（心率）",
          "description": "低 < AeT、中 AeT–LTHR、高 ≥ LTHR。目標：低強度 ≥ 75–80%（Seiler）。LTHR 還是 WKO5 預設值時先到「賽事周期」頁套用估算值。",
          "axes": [{"id": "HHMMSS", "min": 0}],
          "period": "week",
          "series": [
            {"name": "低", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#1baf7a", "expression": "sum(sum(if(heartrate > 0 and heartrate < aethr and (speed > 1.6 or !isvalid(speed)), deltatime)), startofweek(date))"},
            {"name": "中", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#eda100", "expression": "sum(sum(if(heartrate >= aethr and heartrate < lthr and (speed > 1.6 or !isvalid(speed)), deltatime)), startofweek(date))"},
            {"name": "高", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#e34948", "expression": "sum(sum(if(heartrate >= lthr and (speed > 1.6 or !isvalid(speed)), deltatime)), startofweek(date))"}
          ]
        },
        {
          "title": "強度分配：低強度時間佔比",
          "description": "Seiler 的研究：頂尖耐力選手約 75–80% 時間在低強度。長條 = 每週合計，圓點 = 每次活動。低強度 = 心率低於有氧閾值（在「賽事周期」頁填了 AeT 測試就用實測值，沒填就用 WKO5 Friel 心率區間的 Aerobic 上限 0.89 × LTHR）。",
          "axes": [{"id": "PERCENT", "min": 0, "max": 1}],
          "period": "week",
          "series": [
            {"name": "每週", "type": "bar", "y_axis": "PERCENT", "color": "#1baf7a", "expression": "sum(sum(if(heartrate < aethr, deltatime)), startofweek(date)) / sum(sum(if(heartrate > 0, deltatime)), startofweek(date))"},
            {"name": "每次活動", "type": "line", "y_axis": "PERCENT", "color": "#2a78d6", "expression": "sum(if(heartrate < aethr, deltatime)) / sum(if(heartrate > 0, deltatime))"},
            {"name": "75% 目標", "type": "line", "y_axis": "PERCENT", "color": "#1baf7a", "line_style": "dash", "expression": "(,0.75)"},
            {"name": "65% 注意", "type": "line", "y_axis": "PERCENT", "color": "#eda100", "line_style": "dash", "expression": "(,0.65)"}
          ]
        },
        {
          "title": "每週跑步功率區間（Palladino）",
          "description": "Z1 < 80% CP、Z2 80–88%、Z3 88–101%、Z4 101–106%、Z5+ ≥ 106%。只算有功率的跑步。",
          "axes": [{"id": "HHMMSS", "min": 0}],
          "period": "week",
          "series": [
            {"name": "Z1 <80%", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#1baf7a", "expression": "sum(sum(if(runpower > 0 and runpower < 0.80*cp, deltatime)), startofweek(date))"},
            {"name": "Z2 80–88%", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#2a78d6", "expression": "sum(sum(if(runpower >= 0.80*cp and runpower < 0.88*cp, deltatime)), startofweek(date))"},
            {"name": "Z3 88–101%", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#eda100", "expression": "sum(sum(if(runpower >= 0.88*cp and runpower < 1.01*cp, deltatime)), startofweek(date))"},
            {"name": "Z4 101–106%", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#eb6834", "expression": "sum(sum(if(runpower >= 1.01*cp and runpower < 1.06*cp, deltatime)), startofweek(date))"},
            {"name": "Z5+ ≥106%", "type": "stackedbar", "y_axis": "HHMMSS", "color": "#e34948", "expression": "sum(sum(if(runpower >= 1.06*cp, deltatime)), startofweek(date))"}
          ]
        }
      ]
    },
    {
      "title": "能力",
      "description": "進步的證據：有氧效率、心率飄移、爬坡速度、爬升密度、長時間與耐久度。",
      "charts": [
        {
          "title": "有氧效率 EF（輕鬆路跑）",
          "description": "每下心跳換到的速度（m/min per bpm）。往上走 = 有氧引擎變強。只取 ≥ 30 分鐘、平均心率 ≤ AeT + 3 的路跑才能公平比較（和總覽「有氧效率」指標同一個條件）。",
          "axes": [{"id": "CUSTOMm/min/bpm", "min": 0}],
          "series": [
            {"name": "EF", "type": "line", "y_axis": "CUSTOMm/min/bpm", "color": "#2a78d6", "expression": "if(sport=\"run\" and !hastag(\"runningtrail\") and duration >= 1800 and avg(heartrate) <= aethr + 3, avg(speed)/avg(heartrate)*1000/60)"}
          ]
        },
        {
          "title": "心率飄移 Pa:HR（> 40 分鐘的跑步）",
          "description": "後半段每單位速度多用多少心跳。< 5% = 在有氧閾值以下（Uphill Athlete）。",
          "axes": [{"id": "PERCENT"}],
          "series": [
            {"name": "路跑", "type": "line", "y_axis": "PERCENT", "color": "#2a78d6", "expression": "if(sport=\"run\" and !hastag(\"runningtrail\") and duration >= 2400, pahr)"},
            {"name": "越野跑", "type": "line", "y_axis": "PERCENT", "color": "#eb6834", "expression": "if(hastag(\"runningtrail\") and duration > 2400 and abs(pahr) < 0.3, pahr)"},
            {"name": "5% 門檻", "type": "line", "y_axis": "PERCENT", "color": "#8a8984", "line_style": "dash", "expression": "(,0.05)"},
            {"name": "10% 注意", "type": "line", "y_axis": "PERCENT", "color": "#e34948", "line_style": "dash", "expression": "(,0.10)"}
          ]
        },
        {
          "title": "爬坡速度 VAM（越野 + 登山）",
          "description": "每小時爬升公尺數。相近心率下 VAM 上升 = 爬坡進步。",
          "axes": [{"id": "METERSPERHOUR", "min": 0}],
          "series": [
            {"name": "越野跑", "type": "line", "y_axis": "METERSPERHOUR", "color": "#eb6834", "expression": "if(hastag(\"runningtrail\") and climbing > 200, vam)"},
            {"name": "登山健行", "type": "line", "y_axis": "METERSPERHOUR", "color": "#1baf7a", "expression": "if((hastag(\"hiking\") or hastag(\"mountaineering\")) and climbing > 200, vam)"}
          ]
        },
        {
          "title": "爬升密度（每公里爬升）",
          "description": "Koop：拿每公里爬升對照目標賽事，而不是追週總量。",
          "axes": [{"id": "CUSTOMm/km", "min": 0}],
          "series": [
            {"name": "越野 + 登山", "type": "line", "y_axis": "CUSTOMm/km", "color": "#1baf7a", "expression": "if((hastag(\"runningtrail\") or hastag(\"hiking\") or hastag(\"mountaineering\")) and distance > 3, climbing/distance)"},
            {"name": "目標賽事", "type": "line", "y_axis": "CUSTOMm/km", "color": "#e34948", "line_style": "dash", "expression": "goalclimbperkm"}
          ]
        },
        {
          "title": "每次移動時間（跑步、越野、登山）",
          "description": "最長單次應該逐步接近目標賽事的時間（Koop）。",
          "axes": [{"id": "HHMMSS", "min": 0}],
          "series": [
            {"name": "路跑", "type": "line", "y_axis": "HHMMSS", "color": "#2a78d6", "expression": "if(sport=\"run\" and !hastag(\"runningtrail\"), movingduration)"},
            {"name": "越野跑", "type": "line", "y_axis": "HHMMSS", "color": "#eb6834", "expression": "if(hastag(\"runningtrail\"), movingduration)"},
            {"name": "登山健行", "type": "line", "y_axis": "HHMMSS", "color": "#1baf7a", "expression": "if(hastag(\"hiking\") or hastag(\"mountaineering\"), movingduration)"}
          ]
        },
        {
          "title": "耐久度：長時間後段心率飄移",
          "description": "超過 90 分鐘的越野跑，後半段效率掉多少。飄移越小 = 越能撐住後段（耐久度，durability）。登山的 Pa:HR 混了休息時間、會亂跳，所以不算；|飄移| > 30% 當成壞資料（和總覽「耐久度」指標同一個條件）。",
          "axes": [{"id": "PERCENT"}],
          "series": [
            {"name": "飄移", "type": "line", "y_axis": "PERCENT", "color": "#e34948", "expression": "if(hastag(\"runningtrail\") and duration > 5400 and abs(pahr) <= 0.3, pahr)"},
            {"name": "5%", "type": "line", "y_axis": "PERCENT", "color": "#8a8984", "line_style": "dash", "expression": "(,0.05)"},
            {"name": "15% 掉很多", "type": "line", "y_axis": "PERCENT", "color": "#e34948", "line_style": "dash", "expression": "(,0.15)"}
          ]
        }
      ]
    }
  ]
}
