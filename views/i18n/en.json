      "long-run-km": {
        "title": "Long-run distance (road runs ≥ 90 min)",
        "description": "Distance of every road run of 90 minutes or more.\nHow to read: blue bar = one long run.\nLook for: bars stepping up, then coming down in the taper.\nMethod: Pfitzinger, Advanced Marathoning: the long run is the key marathon session; the longest runs of the specific phase are about 32–35 km."
      },
      "long-run-pace": {
        "title": "Long-run pace (road runs ≥ 90 min)",
        "description": "Average moving pace of every road run of 90 minutes or more.\nHow to read: one dot per long run; faster is better.\nLook for: the same easy long run getting faster at the same heart rate = aerobic progress; marathon-pace segments make it a bit faster in the specific phase. Read the trend, not single runs (weather, route).\nMethod: moving pace (stops excluded)."
      },
      "mp-weekly": {
        "title": "Weekly marathon-pace time",
        "description": "Time per week at marathon pace.\nHow to read: orange bar = one week.\nLook for: growing through the specific phase; near zero in the base phase is normal.\nMethod: marathon pace = threshold pace × 1.04–1.08 (estimate: centre × 1.06); needs a threshold pace (set or estimated). Pfitzinger's marathon-pace long runs, Canova's specific sessions."
      }
    }
