  {
   "name": "schedule-push",
   "page": "schedule",
   "viewport": [
    1000,
    380
   ],
   "steps": [
    {
     "wait": ".chip.sc"
    },
    {
     "click": "#push-caret"
    },
    {
     "wait": "#push-menu"
    }
   ],
   "hide": [
    ".sugbox"
   ],
   "mock": [
    {
     "url": "**/api/v1/overview/plan/calendar*",
     "set": {
      "coros.authenticated": true
     }
    },
    {
     "url": "**/api/v1/sync/primary",
     "set": {
      "logged_in": true,
      "enabled": true
     }
    }
   ],
   "init": "try { localStorage.setItem('schedule.view', JSON.stringify('week')); } catch (e) {}"
  },
  {
   "name": "schedule-calendar",
   "page": "settings",
   "hash": "#calendar",
   "steps": [
    {
     "wait": "#calendar"
    },
    {
     "eval": "(() => { const b = document.querySelector('#cal-create'); if (b && !b.hidden && b.offsetParent) b.click(); })()"
    },
    {
     "sleep": 1000
    }
   ],
   "clip": "#calendar",
   "hide": [
    ".an-build",
    ".an-offline",
    ".appnav",
    ".sugbox"
   ]
  },
